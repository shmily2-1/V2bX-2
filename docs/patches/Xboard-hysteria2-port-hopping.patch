+    private static function buildHysteria2PortHoppingConfig(Server $node): array
+    {
+        // The public port range and the backend's single listening port are
+        // different fields. Keep this aligned with the subscription exporters.
+        $port = trim((string) $node->port);
+        if (!preg_match('/^([0-9]{1,5})(?:-([0-9]{1,5}))?$/D', $port, $matches)) {
+            throw new \InvalidArgumentException('Hysteria2 port must be a single port or start-end range; comma lists are not supported by Xboard subscriptions.');
+        }
+        $first = (int) $matches[1];
+        $last = isset($matches[2]) ? (int) $matches[2] : $first;
+        if ($first < 1 || $last > 65535 || $first > $last) {
+            throw new \InvalidArgumentException('Hysteria2 ports must be an ascending range within 1..65535.');
+        }
+        $interval = data_get($node->protocol_settings, 'hop_interval');
+        if ($interval !== null && (int) $interval !== 0 && (int) $interval < 5) {
+            throw new \InvalidArgumentException('Hysteria2 hop_interval must be at least 5 seconds, or empty/0 for the client default.');
+        }
+        return [
+            'ports' => isset($matches[2]) ? "{$first}-{$last}" : null,
+            'hop_interval' => $interval === null ? null : (int) $interval,
+        ];
+    }
